{
  "name": "llm-reliability-client-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:infra",
    "test:unit": "node --test lib/*.test.cjs",
    "test:infra": "node --test e2e/infra.test.cjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "next": "15.5.29",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "typescript": "5.5.3"
  },
  "overrides": {
    "postcss": "8.5.28",
    "source-map-js": "1.2.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
